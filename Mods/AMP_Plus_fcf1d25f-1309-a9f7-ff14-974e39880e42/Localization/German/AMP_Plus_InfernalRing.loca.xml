<contentList>
	<content contentuid="he9f32d68g0b86g493eg880dgad8d06bc29d7" version="1">Höllenmal</content>
	<content contentuid="hc7f0d3dcg8f9ag4b8fg983egf778ffb2db10" version="1">Wenn du&lt;b&gt;[2]&lt;/b&gt; gegen ein Ziel verursachst, das unter &lt;LSTag Type="Status" Tooltip="BURNING_HELLFIRE"&gt;Höllenfeuer&lt;/LSTag&gt; steht, erhält es zusätzlich &lt;LSTag Type="Status" Tooltip="MAG_Ring43_Status_1"&gt;Teufelsfeuer&lt;/LSTag&gt; für &lt;b&gt;[1]&lt;/b&gt; Züge.</content>
	<content contentuid="h54e8320ag9e57g4053gaca3g5cf956562df2" version="1">Wenn du&lt;b&gt;[2]&lt;/b&gt; gegen ein Ziel verursachst, das unter &lt;LSTag Type="Status" Tooltip="BURNING_HELLFIRE"&gt;Höllenfeuer&lt;/LSTag&gt; steht, erhält es zusätzlich &lt;LSTag Type="Status" Tooltip="MAG_Ring43_4_Status_1"&gt;Teufelsfeuer&lt;/LSTag&gt; für &lt;b&gt;[1]&lt;/b&gt; Züge.</content>
	<content contentuid="h6498381bg068ag4b87g91a8g4bca525ca940" version="1">Höllenschmiede</content>
	<content contentuid="h31b4c4e6g39e6g49a1ga9a8ge0d6fd14f69f" version="1">Aus Höllenmetall geschmiedet, erlaubt dieser Ring das Wirken von &lt;LSTag Type="Spell" Tooltip="MAG_Ring43_4_scorchingVolley"&gt;Sengender Salve&lt;/LSTag&gt; und verringert allen eingehenden&lt;b&gt;[1]&lt;/b&gt; um &lt;b&gt;[2]&lt;/b&gt;.</content>
	<content contentuid="hea2c2781geea0g4fd9gae16g7cdcb44ce7b7" version="1">Teufelsfeuer</content>
	<content contentuid="hc48051c4g9c9fg4df8g9cbcg760563dc63d0" version="1">Die betroffene Kreatur wird &lt;LSTag Tooltip="Vulnerable"&gt;verwundbar&lt;/LSTag&gt; gegen&lt;b&gt;[1]&lt;/b&gt;.</content>
	<content contentuid="hc6b64c20g9931g4259g9b6bg07aab2222a6a" version="1">Sengende Salve</content>
</contentList>
